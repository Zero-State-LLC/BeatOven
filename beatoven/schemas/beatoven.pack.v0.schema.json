{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beatoven.pack.v0.schema.json",
  "title": "BeatOven Pack v0",
  "type": "object",
  "required": ["meta", "seed", "inputs", "midi", "session_recipe", "provenance"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["overlay_id", "overlay_version", "generated_at_utc"],
      "properties": {
        "overlay_id": { "const": "beatoven" },
        "overlay_version": { "type": "string" },
        "generated_at_utc": { "type": "string" }
      }
    },
    "seed": { "type": "integer", "minimum": 0 },
    "inputs": {
      "type": "object",
      "description": "OracleSignalLayer.v2 + optional overlays; store hashes + minimal summaries for privacy."
    },
    "midi": {
      "type": "object",
      "required": ["tempo_bpm", "time_signature", "tracks", "markers"],
      "properties": {
        "tempo_bpm": { "type": "number", "minimum": 40, "maximum": 220 },
        "time_signature": {
          "type": "object",
          "required": ["num", "den"],
          "properties": {
            "num": { "type": "integer", "minimum": 1, "maximum": 13 },
            "den": { "type": "integer", "enum": [2, 4, 8, 16] }
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "midi_channel", "instrument_role", "clips", "cc_lanes"],
            "properties": {
              "name": { "type": "string" },
              "midi_channel": { "type": "integer", "minimum": 1, "maximum": 16 },
              "instrument_role": {
                "type": "string",
                "enum": ["DRUMS", "BASS", "HARMONY", "MELODY", "TEXTURE", "FX", "VOCAL_PROXY", "CONTROL"]
              },
              "program_change": { "type": "integer", "minimum": 0, "maximum": 127 },
              "clips": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["clip_id", "bars", "notes"],
                  "properties": {
                    "clip_id": { "type": "string" },
                    "bars": { "type": "number", "minimum": 0.25, "maximum": 64 },
                    "notes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["t", "dur", "pitch", "vel"],
                        "properties": {
                          "t": { "type": "number", "minimum": 0 },
                          "dur": { "type": "number", "minimum": 0.01 },
                          "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
                          "vel": { "type": "integer", "minimum": 1, "maximum": 127 }
                        }
                      }
                    }
                  }
                }
              },
              "cc_lanes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["cc", "points", "meaning"],
                  "properties": {
                    "cc": { "type": "integer", "minimum": 0, "maximum": 127 },
                    "meaning": { "type": "string" },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["t", "v"],
                        "properties": {
                          "t": { "type": "number", "minimum": 0 },
                          "v": { "type": "integer", "minimum": 0, "maximum": 127 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "label"],
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "cv": {
      "type": "object",
      "description": "Optional CV/Gate data representation (no hardware IO).",
      "properties": {
        "clock_hz": { "type": "number", "minimum": 0.1, "maximum": 30 },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lane_type", "points", "meaning"],
            "properties": {
              "lane_type": { "type": "string", "enum": ["PITCH_CV", "MOD_CV", "GATE", "TRIGGER", "RESET", "CLOCK"] },
              "meaning": { "type": "string" },
              "points": {
                "type": "array",
                "items": { "type": "object", "required": ["t", "v"], "properties": { "t": { "type": "number" }, "v": { "type": "number" } } }
              }
            }
          }
        }
      }
    },
    "session_recipe": {
      "type": "object",
      "required": ["daw_targets", "routing", "export_steps"],
      "properties": {
        "daw_targets": {
          "type": "array",
          "items": { "type": "string", "enum": ["ABLETON", "LOGIC", "FL_STUDIO", "REAPER", "BITWIG", "GENERIC"] }
        },
        "routing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["track", "target", "notes"],
            "properties": { "track": { "type": "string" }, "target": { "type": "string" }, "notes": { "type": "string" } }
          }
        },
        "export_steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["input_hashes", "output_hashes", "determinism"],
      "properties": {
        "input_hashes": { "type": "object" },
        "output_hashes": { "type": "object" },
        "determinism": {
          "type": "object",
          "required": ["mode", "twelve_run_invariance"],
          "properties": { "mode": { "const": "SEED" }, "twelve_run_invariance": { "type": "boolean" } }
        }
      }
    }
  }
}
